{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-window-minimize",
    "allow-window-maximize",
    "allow-window-close",
    "allow-window-start-dragging",
    "allow-is-vault-initialized",
    "allow-validate-vault-password",
    "allow-lock-vault",
    "allow-change-master-password",
    "allow-reset-vault",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-verify-pin",
    "allow-list-notes",
    "allow-save-note",
    "allow-delete-note",
    "allow-get-ai-settings",
    "allow-save-ai-settings",
    "allow-set-ai-api-key",
    "allow-clear-ai-api-key",
    "allow-ai-preview-context",
    "allow-ai-chat",
    "allow-ai-get-providers",
    "allow-ai-save-provider",
    "allow-ai-delete-provider",
    "allow-ai-get-routing-matrix",
    "allow-ai-save-routing-rule",
    "allow-ai-get-personas",
    "allow-ai-save-persona",
    "allow-ai-delete-persona",
    "allow-ai-get-habits",
    "allow-ai-search-habits",
    "allow-ai-toggle-habit-pin",
    "allow-ai-delete-habit",
    "allow-ai-get-skills",
    "allow-ai-save-skill",
    "allow-ai-delete-skill",
    "allow-ai-dispatch-task",
    "allow-ai-dispatch-task-with-skill",
    "allow-submit-feedback",
    "allow-get-pending-crash-report",
    "allow-dismiss-crash-report",
    "allow-export-encrypted-backup",
    "allow-import-encrypted-backup",
    "allow-get-performance-prefs",
    "allow-set-performance-prefs",
    "dialog:default",
    "process:default",
    "fs:default"
  ]
}
