{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-window-minimize",
    "allow-window-maximize",
    "allow-window-close",
    "allow-window-start-dragging",
    "allow-is-vault-initialized",
    "allow-validate-vault-password",
    "allow-lock-vault",
    "allow-change-master-password",
    "allow-reset-vault",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-verify-pin",
    "allow-list-notes",
    "allow-save-note",
    "allow-delete-note",
    "allow-get-ai-settings",
    "allow-save-ai-settings",
    "allow-set-ai-api-key",
    "allow-clear-ai-api-key",
    "allow-ai-preview-context",
    "allow-ai-chat",
    "allow-submit-feedback",
    "allow-get-pending-crash-report",
    "allow-dismiss-crash-report",
    "allow-export-encrypted-backup",
    "allow-import-encrypted-backup",
    "allow-get-performance-prefs",
    "allow-set-performance-prefs",
    "dialog:default",
    "process:default",
    "fs:default"
  ]
}
